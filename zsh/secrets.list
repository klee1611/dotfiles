# Names of secrets kept in macOS Keychain (see zsh/load_secrets).
# Only names are stored here — values live in Keychain, never in this file.
# Nothing is exported into the shell; hand a secret to one command with:
#   secret-run VAR_NAME -- command
#
# To store a value:  secret-set VAR_NAME   (prompts; never pass the value inline)
# To check status:   secret-list
#
# Only list static tokens that have no login flow. Prefer a CLI login where
# one exists — nothing long-lived to store or leak:
#   Claude / Anthropic  claude login
#   AWS                 aws configure sso && aws sso login
#   Google Cloud        gcloud auth login && gcloud auth application-default login

# Kaggle
KAGGLE_API_TOKEN
