# Keeps API keys and tokens in macOS Keychain and hands them out per command.
# Values are never written to files, never exported into the shell, and never
# passed as command arguments. zsh/secrets.list (safe to commit) records only
# which names you expect to have stored.
#
# Usage:
#   secret-set VAR_NAME              — store or replace a secret (prompts for it)
#   secret-run VAR... -- command     — run one command with those secrets set
#   secret-get VAR_NAME              — print a secret's value
#   secret-del VAR_NAME              — remove a secret from Keychain
#   secret-list                      — show which tracked secrets are stored
#
# Items are stored with no trusted applications (-T ""), so every read shows a
# macOS dialog asking for your login password. Choose "Allow", not
# "Always Allow" — the latter re-trusts `security` and reads go silent again.
#
# `security` is called by absolute path so a fake `security` planted earlier
# on PATH cannot intercept values.

_SECRETS_SERVICE="dotfiles-env"
_SECRETS_LIST="${HOME}/.config/zsh/secrets.list"
_SECRETS_SECURITY="/usr/bin/security"

# Store or replace a secret. The value is never accepted as an argument:
# arguments land in shell history and are visible to `ps`. `security` prompts
# for it (with confirmation) instead.
secret-set() {
  local name="$1"
  if [[ -z "$name" || $# -gt 1 ]]; then
    echo "Usage: secret-set VAR_NAME   (you will be prompted for the value)" >&2
    return 1
  fi
  # Delete and re-add rather than -U: an in-place update keeps the old access
  # list, and this must always end up with no trusted applications.
  "$_SECRETS_SECURITY" delete-generic-password -s "$_SECRETS_SERVICE" -a "$name" &>/dev/null
  "$_SECRETS_SECURITY" add-generic-password -s "$_SECRETS_SERVICE" -a "$name" -T "" -w \
    || { echo "Secret '$name' was not saved." >&2; return 1; }
  echo "Secret '$name' saved to Keychain."
}

# Print a secret's value (shows the Keychain approval dialog)
secret-get() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: secret-get VAR_NAME" >&2
    return 1
  fi
  "$_SECRETS_SECURITY" find-generic-password -s "$_SECRETS_SERVICE" -a "$name" -w 2>/dev/null \
    || { echo "Secret '$name' not found in Keychain (or access denied)." >&2; return 1; }
}

# Run a single command with the named secrets in its environment only.
# The values reach that command (and anything it starts) and nothing else.
secret-run() {
  local -a names
  while (( $# )) && [[ "$1" != "--" ]]; do names+=("$1"); shift; done
  if [[ "$1" != "--" || $# -lt 2 || ${#names} -eq 0 ]]; then
    echo "Usage: secret-run VAR_NAME... -- command [args...]" >&2
    return 1
  fi
  shift
  # Subshell + exec: exports never touch this shell, and values go into the
  # command's environment rather than onto any command line.
  (
    local name value
    for name in "${names[@]}"; do
      value="$(secret-get "$name")" || exit 1
      export "$name"="$value"
    done
    unset value
    exec "$@"
  )
}

# Remove a secret from Keychain
secret-del() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "Usage: secret-del VAR_NAME" >&2
    return 1
  fi
  "$_SECRETS_SECURITY" delete-generic-password -s "$_SECRETS_SERVICE" -a "$name" &>/dev/null \
    && echo "Secret '$name' removed from Keychain." \
    || echo "Secret '$name' not found in Keychain." >&2
}

# Show which names in secrets.list are stored. Only checks that an item
# exists (no -w), so it never reads a value and never prompts.
secret-list() {
  if [[ ! -f "$_SECRETS_LIST" ]]; then
    echo "No secrets.list found at $_SECRETS_LIST"
    return
  fi
  echo "Tracked secrets (names only — values are in Keychain):"
  local name
  while IFS= read -r name || [[ -n "$name" ]]; do
    [[ "$name" =~ '^[[:space:]]*(#|$)' ]] && continue
    name="${name//[[:space:]]/}"
    if "$_SECRETS_SECURITY" find-generic-password -s "$_SECRETS_SERVICE" -a "$name" &>/dev/null; then
      echo "  ✔ $name"
    else
      echo "  ✘ $name (not yet stored — run: secret-set $name)"
    fi
  done < "$_SECRETS_LIST"
}

# Keep `secret-set NAME value` out of history in case a value is typed inline
# out of habit. secret-set rejects it, but zsh would have recorded it already.
_secrets_history_guard() {
  ! [[ "$1" =~ 'secret-set[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]' ]]
}
autoload -Uz add-zsh-hook
add-zsh-hook zshaddhistory _secrets_history_guard
